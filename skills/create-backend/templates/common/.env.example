NODE_ENV=development
APP_NAME=App
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

__DATABASE_ENV__

REDIS_URLS=redis://localhost:6379
REDIS_PASSWORD=

JWT_SECRET=replace-with-64-random-hex-chars
JWT_REFRESH_SECRET=replace-with-a-different-64-random-hex-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MODEL_POOL=
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_KEY_ENCRYPTION_SECRET=replace-with-64-random-hex-chars
ALLOW_PRIVATE_AI_HOSTS=false

RATE_LIMIT_ENABLED=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=10
RATE_LIMIT_WRITE_MAX_REQUESTS=60
RATE_LIMIT_READ_MAX_REQUESTS=240
RATE_LIMIT_AI_WINDOW_MS=600000
RATE_LIMIT_AI_MAX_REQUESTS=20

BCRYPT_ROUNDS=12
REFRESH_COOKIE_NAME=rt
REFRESH_COOKIE_MAX_AGE_MS=604800000
LOG_LEVEL=info
